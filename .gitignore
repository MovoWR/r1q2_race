# Local build output and historical validation packages.
/build/
/cmake-build-*/

# Local IDE settings and migration backup.
/.idea/
/.idea-before-move-*/

# Python caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Compiler intermediates.
CMakeFiles/
*.o
*.obj
*.pch
*.ipch
*.ilk
*.idb
